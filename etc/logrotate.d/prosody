/var/log/prosody/prosody.log /var/log/prosody/prosody.info /var/log/prosody/prosody.warn /var/log/prosody/prosody.err /var/log/prosody/prosody.debug {
        daily
        rotate 14
        compress
        delaycompress
        # Don't signal Prosody after rotating: SIGHUP (service prosody reload) is a full
        # config reload, which froze the whole server for 6-10 seconds every night.
        # Prosody opens its logs in append mode, so truncating in place is safe.
        copytruncate
        missingok
        notifempty
}
